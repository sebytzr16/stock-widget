<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Widget text. Colors come from resources with night variants, so widgets follow the system theme. -->
    <style name="WidgetText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/widget_text</item>
    </style>

    <style name="WidgetText.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="WidgetText.Symbol">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="WidgetText.Change">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/widget_up</item>
    </style>

    <style name="WidgetText.Price">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">12sp</item>
        <item name="android:autoSizeMaxTextSize">22sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
    </style>

    <style name="WidgetText.BigPrice" parent="WidgetText.Price">
        <item name="android:textSize">26sp</item>
        <item name="android:autoSizeMaxTextSize">26sp</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <style name="WidgetText.HeaderPrice">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="WidgetText.CellPrice" parent="WidgetText.Price">
        <item name="android:textSize">15sp</item>
        <item name="android:autoSizeMinTextSize">10sp</item>
        <item name="android:autoSizeMaxTextSize">15sp</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:layout_marginBottom">1dp</item>
    </style>

    <style name="WidgetText.Label">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/widget_text2</item>
    </style>

    <style name="WidgetText.Info">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/widget_text2</item>
    </style>

    <style name="WidgetText.Hint">
        <item name="android:gravity">center</item>
        <item name="android:maxLines">3</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/widget_text2</item>
    </style>
</resources>
