<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="6dp">

    <TextView
        android:id="@+id/symbol"
        style="@style/WidgetText.Label"
        android:text="@string/widget_sample_symbol" />

    <TextView
        android:id="@+id/price"
        style="@style/WidgetText.CellPrice"
        android:text="@string/widget_sample_price" />

    <TextView
        android:id="@+id/change"
        style="@style/WidgetText.Change"
        android:text="@string/widget_sample_change" />
</LinearLayout>
